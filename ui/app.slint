import "../assets/fonts/Monda.ttf";

import {
    WindowControlButtons,
    VerticalSeparator,
    IconButton,
    Typography,
    Metrics,
    Colors,
    Center,
    Icons,
    Right,
    Left,
} from "lib.slint";

import {
    WindowState,
} from "globals.slint";

export {
    CollectionState,
    GalleryState,
    WindowState,
    TabState,
    Actions,
} from "globals.slint";

export component App inherits Window {
    title: "Eyeris";
    icon: @image-url("../assets/icon.svg");

    default-font-family: "Monda";
    default-font-weight: Typography.regular;

    background: Colors.bg;

    min-width: 960px;
    min-height: 640px;
    preferred-width: 1560px;
    preferred-height: 840px;
    maximized: true;

    no-frame: true;
    resize-border-width: 6px;

    changed width => {
        WindowState.width = root.width;
    }

    changed height => {
        WindowState.height = root.height;
    }

    WindowMoveArea {
        HorizontalLayout {
            left := Rectangle {
                background: Colors.bg-area;
                width: 240px;

                Left { }
            }

            VerticalSeparator { }

            center := Center { }

            VerticalSeparator { }

            right := Rectangle {
                background: Colors.bg-area;
                width: 360px;

                Right { }
            }
        }
    }

    Rectangle {
        x: WindowState.width - window-control-buttons.preferred-width;
        y: 0;
        width: window-control-buttons.preferred-width;
        height: window-control-buttons.preferred-height;

        window-control-buttons := WindowControlButtons {
            minimize => {
                root.minimized = true;
            }

            maximize => {
                root.maximized = !root.maximized;
            }

            close => {
                root.hide();
            }
        }
    }
}
