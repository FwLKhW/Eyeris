import "../assets/fonts/Monda.ttf";

import { AppContent, TitleBar, UIPalette, UITypography } from "ui.slint";

export component App inherits Window {
    default-font-family: "Monda";
    default-font-weight: UITypography.regular;

    min-width: 960px;
    min-height: 640px;

    background: UIPalette.bg;

    VerticalLayout {
        TitleBar {
            vertical-stretch: 0;
        }

        AppContent {
            vertical-stretch: 1;
        }
    }
}
