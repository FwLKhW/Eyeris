import "../assets/fonts/Monda.ttf";

import {
    ImagePreviewState,
    LayoutState,
    WindowState,
    Actions,
} from "globals.slint";
import {
    FullButtonPopover,
    HorizontalDivider,
    IconButtonPopover,
    UITypography,
    IconButton,
    FullButton,
    UIMetrics,
    UIPalette,
    TitleBar,
    Icons,
    Main,
} from "lib.slint";

export { Actions, WindowState, LayoutState, ImagePreviewState }
export component App inherits Window {
    title: "Eyeris";
    icon: @image-url("../assets/icon.svg");

    default-font-family: "Monda";
    default-font-weight: UITypography.regular;

    background: UIPalette.bg;

    min-width: 960px;
    min-height: 640px;
    preferred-width: 1560px;
    preferred-height: 840px;
    maximized: true;

    no-frame: true;
    resize-border-width: 6px;

    forward-focus: scope;

    changed width => {
        WindowState.width = root.width;
    }

    changed height => {
        WindowState.height = root.height;
    }

    scope := FocusScope {
        capture-key-pressed(event) => {
            if event.modifiers.alt || event.text == Key.Escape || event.text == Key.Return {
                self.focus();
            }
            reject
        }

        KeyBinding {
            keys: @keys(Alt + T);
            activated => {
                LayoutState.show-titlebar = !LayoutState.show-titlebar;
            }
        }

        KeyBinding {
            keys: @keys(Alt + B);
            activated => {
                LayoutState.show-left = !LayoutState.show-left;
            }
        }

        KeyBinding {
            keys: @keys(Alt + M);
            activated => {
                LayoutState.show-right = !LayoutState.show-right;
            }
        }

        KeyBinding {
            keys: @keys(Alt + F);
            activated => {
                LayoutState.show-filter = !LayoutState.show-filter;
            }
        }

        KeyBinding {
            keys: @keys(Alt + Q);
            activated => {
                root.hide();
            }
        }

        KeyBinding {
            keys: @keys(Alt + Z);
            activated => {
                LayoutState.zen-mode = !LayoutState.zen-mode;
                if LayoutState.zen-mode {
                    LayoutState.prev-show-filter = LayoutState.show-filter;
                    LayoutState.prev-show-left = LayoutState.show-left;
                    LayoutState.prev-show-right = LayoutState.show-right;
                    LayoutState.prev-show-titlebar = LayoutState.show-titlebar;
                    LayoutState.show-filter = false;
                    LayoutState.show-left = false;
                    LayoutState.show-right = false;
                    LayoutState.show-titlebar = false;
                } else {
                    LayoutState.show-filter = LayoutState.prev-show-filter;
                    LayoutState.show-left = LayoutState.prev-show-left;
                    LayoutState.show-right = LayoutState.prev-show-right;
                    LayoutState.show-titlebar = LayoutState.prev-show-titlebar;
                }
            }
        }

        WindowMoveArea {
            enabled: !root.full-screen && !ImagePreviewState.is-active;

            VerticalLayout {
                if LayoutState.show-titlebar: VerticalLayout {
                    TitleBar {
                        window-minimize => { root.minimized = true; }
                        window-maximize => { root.maximized = !root.maximized; }
                        window-close => { root.hide(); }
                    }

                    HorizontalDivider { }
                }

                Main { }
            }
        }
    }

    // Image preview overlay
    Rectangle {
        visible: ImagePreviewState.is-active;
        background: rgba(0, 0, 0, 0.8);
        z: 999;

        Image {
            source: ImagePreviewState.current-source;
            x: root.width / 2 - (ImagePreviewState.current-source.width / 2 * 1phx) + (ImagePreviewState.delta-x * root.width / 512 / 1px);
            y: root.height / 2 - (ImagePreviewState.current-source.height / 2 * 1phx) + (ImagePreviewState.delta-y * root.height / 512 / 1px);
            width: ImagePreviewState.current-source.width * 1phx;
            height: ImagePreviewState.current-source.height * 1phx;
        }
    }
}
