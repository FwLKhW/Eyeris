import "../assets/fonts/Monda.ttf";

import { Typography } from "typography.slint";
import { Theme } from "theme.slint";

import {
    ImageOverlayState,
    WindowState,
    State,
} from "globals.slint";

import { Center } from "views/center.slint";
import { Right } from "views/right.slint";
import { Left } from "views/left.slint";

import { WindowControlButtons } from "widgets/window-control-buttons.slint";
import { LoadingOverlay } from "widgets/loading-overlay.slint";
import { ImageOverlay } from "widgets/image-overlay.slint";
import { Titlebar } from "widgets/titlebar.slint";

import { VerticalSeparator } from "components/separator.slint";

export {
    WindowState,
    Action,
    State,
} from "globals.slint";

export component App inherits Window {
    title: "Eyeris";
    icon: @image-url("../assets/icon.svg");

    default-font-family: "Monda";
    default-font-weight: Typography.regular;

    background: Theme.bg;

    min-width: 960px;
    min-height: 640px;
    preferred-width: 1800px;
    preferred-height: 1000px;
    max-width: 8192px;
    max-height: 5120px;

    no-frame: true;
    resize-border-width: 6px;

    changed width => {
        WindowState.width = root.width;
        State.images-per-row = root.width < 200px ? 2 : root.width < 400px ? 3 : 4;
    }

    changed height => {
        WindowState.height = root.height;
    }

    HorizontalLayout {
        HorizontalLayout {
            WindowMoveArea {
                enabled: !ImageOverlayState.show;
                width: 240px;

                Rectangle {
                    background: Theme.bg-area;

                    Left { }
                }
            }

            VerticalSeparator { }
        }

        Center { }

        HorizontalLayout {
            VerticalSeparator { }

            WindowMoveArea {
                enabled: !ImageOverlayState.show;
                width: 360px;

                Rectangle {
                    background: Theme.bg-area;

                    Right { }
                }
            }
        }
    }

    ImageOverlay { }

    LoadingOverlay { }

    Titlebar {
        minimize => { root.minimized = true; }
        maximize => { root.maximized = !root.maximized; }
        close => { root.hide(); }
    }
}
