import "../assets/fonts/Monda.ttf";

import { TitleBar } from "ui.slint";
import { AppContent, UIPalette } from "ui.slint";

export component App inherits Window {
    default-font-family: "Monda";

    min-width: 600px;
    min-height: 300px;
    maximized: true;
    no-frame: false;
    background: UIPalette.bg;

    VerticalLayout {
        TitleBar {}
        AppContent {}
    }
}
