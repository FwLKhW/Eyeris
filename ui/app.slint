import "../assets/fonts/Monda.ttf";

import {
    UITypography,
    UIMetrics,
    UIPalette,
    Icons,
    TitleBar,
    AppContent,
    IconButton,
    FullButton,
    HorizontalDivider,
    IconButtonPopover,
    FullButtonPopover,
} from "ui.slint";
import { Actions, ImagePreviewState, LayoutState } from "globals.slint";

export { Actions }
export component App inherits Window {
    title: "Eyeris";
    icon: @image-url("../assets/icon.svg");

    default-font-family: "Monda";
    default-font-weight: UITypography.regular;

    background: UIPalette.bg;

    min-width: 960px;
    min-height: 640px;
    preferred-width: 1560px;
    preferred-height: 900px;
    maximized: true;

    no-frame: true;
    resize-border-width: 6px;

    forward-focus: scope;

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Control + B);
            activated => {
                LayoutState.show-left-sidebar = !LayoutState.show-left-sidebar;
            }
        }

        KeyBinding {
            keys: @keys(Control + Shift + B);
            activated => {
                LayoutState.show-right-sidebar = !LayoutState.show-right-sidebar;
            }
        }

        KeyBinding {
            keys: @keys(Alt + M);
            activated => {
                LayoutState.show-titlebar = !LayoutState.show-titlebar;
            }
        }

        VerticalLayout {
            if LayoutState.show-titlebar: TitleBar {
                window-minimize => { root.minimized = true; }
                window-maximize => { root.maximized = true; }
                window-close => { root.hide(); }
            }

            HorizontalDivider { }

            AppContent { }
        }
    }

    // Image preview overlay
    Rectangle {
        visible: ImagePreviewState.is-active;
        background: rgba(0, 0, 0, 0.8);
        z: 999;

        Image {
            source: ImagePreviewState.current-source;
            x: root.width / 2 - (ImagePreviewState.current-source.width / 2 * 1phx) + (ImagePreviewState.delta-x * root.width / 512 / 1px);
            y: root.height / 2 - (ImagePreviewState.current-source.height / 2 * 1phx) + (ImagePreviewState.delta-y * root.height / 512 / 1px);
            width: ImagePreviewState.current-source.width * 1phx;
            height: ImagePreviewState.current-source.height * 1phx;
        }
    }
}
