import "../assets/fonts/Monda.ttf";

import {
    WindowControlButtons,
    VerticalSeparator,
    LoadingOverlay,
    IconButton,
    Typography,
    Titlebar,
    Metrics,
    Colors,
    Center,
    Icons,
    Right,
    Left,
} from "lib.slint";

import {
    WindowState,
} from "globals.slint";

export {
    WindowState,
    Action,
    State,
} from "globals.slint";

export component App inherits Window {
    title: "Eyeris";
    icon: @image-url("../assets/icon.svg");

    default-font-family: "Monda";
    default-font-weight: Typography.regular;

    background: Colors.bg;

    min-width: 960px;
    min-height: 640px;
    preferred-width: 1800px;
    preferred-height: 1000px;
    max-width: 8192px;
    max-height: 5120px;

    no-frame: true;
    resize-border-width: 6px;

    changed width => {
        WindowState.width = root.width;
    }

    changed height => {
        WindowState.height = root.height;
    }

    HorizontalLayout {
        HorizontalLayout {
            WindowMoveArea {
                width: 240px;

                Rectangle {
                    background: Colors.bg-area;

                    Left { }
                }
            }

            VerticalSeparator { }
        }

        Center { }

        HorizontalLayout {
            VerticalSeparator { }

            WindowMoveArea {
                width: 360px;

                Rectangle {
                    background: Colors.bg-area;

                    Right { }
                }
            }
        }
    }

    LoadingOverlay {
        z: 998;
    }

    Titlebar {
        z: 999;

        minimize => { root.minimized = true; }
        maximize => { root.maximized = !root.maximized; }
        close => { root.hide(); }
    }
}
