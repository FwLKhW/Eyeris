export struct TextStyle {
    font-size: length,
    font-weight: int
}

export global UITypography {
    out property <int> regular: 400;
    out property <int> medium: 600;
    out property <int> semibold: 900;

    out property <TextStyle> display: {
        font-size: 48px,
        font-weight: root.regular
    };

    out property <TextStyle> headline: {
        font-size: 28px,
        font-weight: root.regular
    };

    out property <TextStyle> title: {
        font-size: 16px,
        font-weight: root.medium
    };

    out property <TextStyle> label: {
        font-size: 12px,
        font-weight: root.medium
    };

    out property <TextStyle> body: {
        font-size: 12px,
        font-weight: root.regular
    };
}
