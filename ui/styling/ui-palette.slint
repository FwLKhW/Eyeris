import { Palette } from "std-widgets.slint";
import { UISchemes, UIScheme } from "ui-schemes.slint";

export global UIPalette {
    out property <color> primary: root.scheme.primary;
    out property <color> error: root.scheme.error;
    
    out property <color> pink: root.scheme.pink;
    out property <color> orange: root.scheme.orange;
    out property <color> blue: root.scheme.blue;
    out property <color> mauve: root.scheme.mauve;
    out property <color> yellow: root.scheme.yellow;
    out property <color> green: root.scheme.green;
    out property <color> red: root.scheme.red;

    out property <color> bg-area: root.scheme.bg-area;
    out property <color> bg: root.scheme.bg;
    out property <color> bg-surface: root.scheme.bg-surface;
    out property <color> bg-hover: root.scheme.bg-hover;

    out property <color> separator: root.scheme.separator;

    out property <color> text: root.scheme.text;
    out property <color> subtext: root.scheme.subtext;

    out property <color> icon: root.scheme.icon;
    out property <color> icon-hover: root.scheme.icon-hover;

    out property <float> focus-opacity: root.scheme.focus-opacity;

    in property <UISchemes> schemes: {
        // TODO: light mode
        light: {
            primary: #E3E3E3,
            error: #D92E41,
            pink: #FA8EAB,
            orange: #FFAF87,
            blue: #82B0FF,
            mauve: #CB88F7,
            yellow: #F5C582,
            green: #A9F073,
            red: #FA8E8E,
            bg-area: #111111,
            bg: #151515,
            bg-surface: #E3E3E313,
            bg-hover: #E3E3E314,
            separator: #212121,
            text: #E3E3E3,
            subtext: #A1A1A1,
            icon: #CFCFCF,
            icon-hover: #E6E6E6,
            focus-opacity: 10%
        },
        dark: {
            primary: #E3E3E3,
            error: #D92E41,
            pink: #FA8EAB,
            orange: #FFAF87,
            blue: #82B0FF,
            mauve: #CB88F7,
            yellow: #F5C582,
            green: #A9F073,
            red: #FA8E8E,
            bg-area: #111111,
            bg: #151515,
            bg-surface: #E3E3E313,
            bg-hover: #E3E3E314,
            separator: #212121,
            text: #E3E3E3,
            subtext: #A1A1A1,
            icon: #CFCFCF,
            icon-hover: #E6E6E6,
            focus-opacity: 10%
        },
    };

    property <UIScheme> scheme: Palette.color-scheme == ColorScheme.dark ? root.schemes.dark : root.schemes.light;
}
