export global UIMetrics {
    // button
    out property <length> btn-h-sm: 24px;
    out property <length> btn-h-md: 32px;
    out property <length> btn-px: 8px;

    // icon
    out property <length> icon-sm: 16px;
    out property <length> icon-md: 20px;

    // border-radius
    out property <length> radius-sm: 5px;
    out property <length> radius-md: 7px;
    out property <length> radius-lg: 9px;

    // spacing
    out property <length> spacing-sm: 4px;
    out property <length> spacing-md: 8px;
    out property <length> spacing-lg: 12px;
}
