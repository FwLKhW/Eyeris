import { Metrics } from "../metrics.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { IconButton } from "../components/button.slint";

export component WindowControlButtons inherits HorizontalLayout {
    callback minimize();
    callback maximize();
    callback close();

    animate opacity { duration: Metrics.opacity-duration; }

    opacity: mini.has-focus || maxi.has-focus || cls.has-focus || mini.has-hover || maxi.has-hover || cls.has-hover ? 1 : 0;

    mini := IconButton {
        size: 28px;
        icon: Icons.minimize;
        ratio: 1.5;
        icon-scale: 0.8;
        tooltip: "Minimize";
        tooltip-offset: self.height + 8px;

        clicked => {
            minimize();
        }
    }

    maxi := IconButton {
        size: 28px;
        icon: Icons.maximize;
        ratio: 1.5;
        icon-scale: 0.8;
        tooltip: "Maximize";
        tooltip-offset: self.height + 8px;

        clicked => {
            maximize();
        }
    }

    cls := IconButton {
        size: 28px;
        icon: Icons.close;
        ratio: 1.5;
        icon-scale: 0.9;
        bg-hover: Theme.danger;
        tooltip: "Close";
        tooltip-offset: self.height + 8px;

        clicked => {
            close();
        }
    }
}
