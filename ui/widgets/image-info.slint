import { IndexedImage } from "../globals.slint";
import { Typography } from "../typography.slint";
import { Metrics } from "../metrics.slint";
import { State } from "../globals.slint";

import { EyerisText } from "../components/text.slint";

component InfoRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> value;

    cross-axis-alignment: center;

    EyerisText {
        text: name;
        width: 10rem;
        style: Typography.label;
    }

    if !value.is-empty: EyerisText {
        text: value;
    }

    @children
}

export component ImageInfo inherits VerticalLayout {
    in property <IndexedImage> img <=> State.selected-image;

    padding: Metrics.px-16;

    if img.width > 0: VerticalLayout {
        spacing: Metrics.px-8;

        InfoRow {
            name: "Name";
            value: img.name;
        }

        InfoRow {
            name: "Type";
            value: img.format;
        }

        InfoRow {
            name: "Size";
            value: img.size < 102400 ? (img.size / 1024).to-fixed(2) + " KB" : (img.size / 1024 / 1024).to-fixed(2) + " MB";
        }

        InfoRow {
            name: "Dimensions";
            value: img.width + " x " + img.height;
        }

        InfoRow {
            name: "Rating";
            value: img.rating;
        }
    }
}
