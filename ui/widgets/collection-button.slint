import { Metrics } from "../metrics.slint";
import { Action } from "../globals.slint";
import { Theme } from "../theme.slint";
import { State } from "../globals.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "../components/separator.slint";
import { StandardButton } from "../components/button.slint";
import { FocusTouchArea } from "../components/area.slint";
import { PopoverOnce } from "../components/popover.slint";
import { EyerisText } from "../components/text.slint";
import { Icon } from "../components/icon.slint";

export component CollectionButton inherits Rectangle {
    in property <string> text: "Collection";

    height: Metrics.px-60;
    background: area.has-hover || area.has-focus ? Theme.bg-hover : transparent;

    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: Metrics.px-8;
        padding-right: Metrics.px-8;

        Icon {
            icon: Icons.heart;
        }

        EyerisText {
            text: root.text.is-empty ? "Collection" : root.text;
        }
    }

    popover := PopoverOnce {
        width: root.width;

        VerticalLayout {
            for collection in State.collection-list: StandardButton {
                icon: Icons.heart;
                text: collection.name;
                
                clicked => {
                    Action.open-collection-by-path(collection.path);
                }
            }

            StandardButton {
                icon: Icons.folder;
                text: "Example";
                
                clicked => {
                    Action.open-collection-by-path("fixtures/Example/");
                }
            }
            
            StandardButton {
                icon: Icons.folder;
                text: "Open";

                clicked => {
                    Action.open-collection();
                }
            }
        }
    }

    area := FocusTouchArea {
        clicked => {
            Action.fetch-collection-list();
            popover.show();
        }
    }
}
