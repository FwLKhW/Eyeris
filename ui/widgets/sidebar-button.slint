import { Typography } from "../typography.slint";
import { Metrics } from "../metrics.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { FocusTouchArea } from "../components/area.slint";
import { EyerisText } from "../components/text.slint";
import { Icon } from "../components/icon.slint";

export component SidebarButton inherits Rectangle {
    in property <image> icon: Icons.box;
    in property <string> text: "Button";
    in property <int> count;

    min-height: Metrics.px-48;
    background: area.has-hover || area.has-focus ? Theme.bg-hover : transparent;

    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: Metrics.px-8;
        padding-right: Metrics.px-8;

        Icon {
            icon: root.icon;
        }

        EyerisText {
            text: root.text;
        }

        if root.count > 0: HorizontalLayout {
            alignment: end;
            padding-left: Metrics.px-8;
            padding-right: Metrics.px-8;

            EyerisText {
                text: root.count;
                style: Typography.small;
                color: Theme.fg-faded;
            }
        }
    }

    area := FocusTouchArea { }
}
