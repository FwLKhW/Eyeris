import {
    ImageOverlayState,
    IndexedImage,
    Action,
    State,
} from "../globals.slint";
import { Typography } from "../typography.slint";
import { Metrics } from "../metrics.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { PropertyRow } from "../widgets/property-row.slint";

import { EyerisText } from "../components/text.slint";
import { Rating } from "../components/rating.slint";

export component ImageItem inherits Rectangle {
    in-out property <IndexedImage> img;

    horizontal-stretch: pow(img.height / img.width, 2) * (1920 / img.width) * (1080 / img.height);

    init => {
        thumbnail.source = Action.get-thumbnail(img.hash);
        thumbnail.opacity = 1;
    }

    VerticalLayout {
        spacing: Metrics.px-32;

        Rectangle {
            height: 256px;
            min-width: 160px;

            HorizontalLayout {
                thumbnail := Image {
                    opacity: 0;
                    // image-fit: ImageFit.contain;
                    image-fit: ImageFit.cover;

                    animate opacity {
                        duration: Metrics.opacity-duration;
                        easing: ease-out;
                    }
                }
            }

            touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;

                clicked => {
                    State.selected-image = img;
                }

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        ImageOverlayState.preview = thumbnail.source;
                        ImageOverlayState.image-path = root.img.path;
                        if ImageOverlayState.loaded-image-path != ImageOverlayState.image-path {
                            ImageOverlayState.source = Action.get-image(ImageOverlayState.image-path);
                        }
                        ImageOverlayState.loaded-image-path = ImageOverlayState.image-path;
                        ImageOverlayState.initial-mouse-x = self.mouse-x;
                        ImageOverlayState.initial-mouse-y = self.mouse-y;
                    } else if (event.kind == PointerEventKind.up) {
                        ImageOverlayState.show = false;
                    }
                }

                moved => {
                    ImageOverlayState.show = true;

                    ImageOverlayState.delta-x = (self.mouse-x - ImageOverlayState.initial-mouse-x) * ((ImageOverlayState.source.width / 1980 + ImageOverlayState.source.height / 1080) / 2);
                    ImageOverlayState.delta-y = (self.mouse-y - ImageOverlayState.initial-mouse-y) * ((ImageOverlayState.source.width / 1980 + ImageOverlayState.source.height / 1080) / 2);
                }
            }
        }

        Rectangle {
            clip: true;

            VerticalLayout {
                cross-axis-alignment: center;

                PropertyRow {
                    img <=> root.img;
                }

                PropertyRow {
                    img <=> root.img;
                    property: rating;
                }

                PropertyRow {
                    img: root.img;
                    property: size;
                }
            }
        }
    }
}
