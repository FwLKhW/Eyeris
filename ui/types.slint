export struct Collection {
    path: string,
    name: string,
}

export struct IndexedImage {
    path: string,
    name: string,
    format: string,
    size: int,
    width: int,
    height: int,
    created: int,
    modified: int,
    rating: int,
    tags: [string],
    hash: string,
    colors: [color],
}
