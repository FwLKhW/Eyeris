struct ColorScheme {
    success: color,
    danger: color,
    pink: color,
    orange: color,
    blue: color,
    mauve: color,
    yellow: color,
    green: color,
    red: color,
    fg: color,
    bg: color,
    bg-area: color,
    bg-surface: color,
    fg-faded-opacity: float,
    bg-hover-opacity: float,
    separator-opacity: float,
}

struct ColorSchemes {
    light: ColorScheme,
    dark: ColorScheme,
}

export global Colors {
    out property <color> success: root.theme.success;
    out property <color> danger: root.theme.danger;

    out property <color> pink: root.theme.pink;
    out property <color> orange: root.theme.orange;
    out property <color> blue: root.theme.blue;
    out property <color> mauve: root.theme.mauve;
    out property <color> yellow: root.theme.yellow;
    out property <color> green: root.theme.green;
    out property <color> red: root.theme.red;

    out property <color> fg: root.theme.fg;
    out property <color> fg-faded: root.theme.fg.with-alpha(root.theme.fg-faded-opacity);
    out property <color> bg: root.theme.bg;
    out property <color> bg-area: root.theme.bg-area;
    out property <color> bg-surface: root.theme.bg-surface;
    out property <color> bg-hover: root.theme.fg.with-alpha(root.theme.bg-hover-opacity);
    out property <color> separator: root.theme.fg.with-alpha(root.theme.separator-opacity);

    out property <float> fg-faded-opacity: root.theme.fg-faded-opacity;
    out property <float> bg-hover-opacity: root.theme.bg-hover-opacity;
    out property <float> separator-opacity: root.theme.separator-opacity;

    in property <ColorSchemes> themes: {
        // TODO: light theme
        light: {
            success: #65fd36,
            danger: #D92E41,
            pink: #FA8EAB,
            orange: #FFAF87,
            blue: #82B0FF,
            mauve: #CB88F7,
            yellow: #F5C582,
            green: #A9F073,
            red: #FA8E8E,
            fg: #E3E3E3,
            bg: #151515,
            bg-area: #111111,
            bg-surface: #242424,
            fg-faded-opacity: 65%,
            bg-hover-opacity: 10%,
            separator-opacity: 10%,
        },
        dark: {
            success: #65fd36,
            danger: #D92E41,
            pink: #FA8EAB,
            orange: #FFAF87,
            blue: #82B0FF,
            mauve: #CB88F7,
            yellow: #F5C582,
            green: #A9F073,
            red: #FA8E8E,
            fg: #E3E3E3,
            bg: #151515,
            bg-area: #111111,
            bg-surface: #242424,
            fg-faded-opacity: 65%,
            bg-hover-opacity: 10%,
            separator-opacity: 5%,
        },
    };

    property <ColorScheme> theme: root.themes.dark;
}
