export global Metrics {
    out property <length> px-4: 4px;
    out property <length> px-6: 6px;
    out property <length> px-8: 8px;
    out property <length> px-12: 12px;
    out property <length> px-16: 16px;
    out property <length> px-24: 24px;
    out property <length> px-32: 32px;
    out property <length> px-48: 48px;
    out property <length> px-60: 60px;
    out property <length> px-96: 96px;

    out property <duration> opacity-duration: 250ms;
}
