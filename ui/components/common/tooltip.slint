import { UIText } from "ui-text.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { UITypography } from "../../styling/ui-typography.slint";

export component ToolTip {
    in property <string> text;

    z: 10000;

    background_layer := Rectangle {
        border_radius: 4px;
        background: UIPalette.bg-surface;

        layout := HorizontalLayout {
            max_width: 200px;
            padding_top: 4px;
            padding_bottom: 4px;
            padding_left: 8px;
            padding_right: 8px;

            UIText {
                text: root.text;
                vertical_alignment: center;
                color: UIPalette.text;
                style: UITypography.body;
                wrap: word-wrap;
            }
        }
    }
}
