import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { IconButton } from "button.slint";
import { EyerisText } from "text.slint";
import { Icon } from "icon.slint";

export component Star inherits Rectangle {
    in property <int> rating;
    in property <int> target-rating;

    height: 24px;
    width: 24px;

    callback clicked();

    icon := Icon {
        icon: Icons.star;
        color: area.has-hover ? Theme.orange : root.rating <= root.target-rating ? Theme.yellow : Theme.fg-faded;
    }

    area := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            root.clicked();
        }
    }
}

export component Rating inherits Rectangle {
    in-out property <int> value;

    HorizontalLayout {
        for i in 5: Star {
            rating: i + 1;
            target-rating: root.value;

            clicked => {
                root.value = i + 1;
            }
        }
    }
}
