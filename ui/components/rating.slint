import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { IconButton } from "button.slint";
import { EyerisText } from "text.slint";
import { Icon } from "icon.slint";

export component Rating inherits Rectangle {
    in-out property <int> value;

    HorizontalLayout {
        for i in 5: IconButton {
            icon: Icons.star;
            // rating: i + 1;
            // target-rating: root.value;

            clicked => {
                root.value = i + 1;
            }
        }
    }
}
