import { Typography } from "../typography.slint";
import { Actions } from "../globals.slint";
import { Metrics } from "../metrics.slint";
import { Colors } from "../colors.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "separator.slint";
import { FocusTouchArea } from "area.slint";
import { EyerisText } from "text.slint";
import { Popover } from "popover.slint";
import { Icon } from "icon.slint";

export component IconButton inherits Rectangle {
    out property <bool> has-hover <=> area.has-hover;
    out property <bool> has-focus <=> area.has-focus;
    in property <length> size <=> icon.size;
    in property <float> ratio: 1;
    in property <image> icon <=> icon.icon;
    in property <float> icon-scale <=> icon.scale;
    in property <color> bg-hover: Colors.bg-hover;
    in property <bool> activated: false;
    in property <string> tooltip <=> area.tooltip;
    in property <length> tooltip-offset <=> area.tooltip-offset;

    height: self.size;
    width: self.height * self.ratio;
    background: area.has-focus || area.has-hover || self.activated ? root.bg-hover : transparent;
    border-radius: Metrics.radius-md;

    callback clicked();

    icon := Icon { }

    area := FocusTouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component StandardButton inherits Rectangle {
    in property <image> icon: Icons.box;
    in property <string> text: "Button";

    callback clicked();

    min-height: 24px;
    background: area.has-hover || area.has-focus ? Colors.bg-hover : transparent;
    border-radius: Metrics.radius-md;

    HorizontalLayout {
        cross-axis-alignment: center;

        Icon {
            icon: root.icon;
        }

        EyerisText {
            text: root.text;
        }
    }

    area := FocusTouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SidebarButton inherits Rectangle {
    in property <image> icon: Icons.box;
    in property <string> text: "Button";
    in property <int> count: 0;

    min-height: 40px;
    background: area.has-hover || area.has-focus ? Colors.bg-hover : transparent;
    border-radius: Metrics.radius-md;

    HorizontalLayout {
        cross-axis-alignment: center;

        Icon {
            icon: root.icon;
        }

        EyerisText {
            text: root.text;
        }

        if root.count > 0: HorizontalLayout {
            alignment: end;
            padding-left: Metrics.spacing-8;
            padding-right: Metrics.spacing-8;

            EyerisText {
                text: root.count;
                style: Typography.small;
                color: Colors.fg-faded;
            }
        }
    }

    area := FocusTouchArea { }
}
