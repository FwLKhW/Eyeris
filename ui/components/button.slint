import { Typography } from "../typography.slint";
import { Metrics } from "../metrics.slint";
import { Action } from "../globals.slint";
import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "separator.slint";
import { FocusTouchArea } from "area.slint";
import { EyerisText } from "text.slint";
import { Popover } from "popover.slint";
import { Icon } from "icon.slint";

export component IconButton inherits Rectangle {
    out property <bool> has-hover <=> area.has-hover;
    out property <bool> has-focus <=> area.has-focus;
    in property <length> size <=> icon.size;
    in property <float> ratio: 1;
    in property <image> icon <=> icon.icon;
    in property <color> icon-color: Theme.fg;
    in property <float> icon-scale <=> icon.scale;
    in property <color> bg-hover: Theme.bg-hover;
    in property <bool> activated: false;
    in property <string> tooltip <=> area.tooltip;
    in property <length> tooltip-offset <=> area.tooltip-offset;

    height: self.size;
    width: self.height * self.ratio;
    background: area.has-focus || area.has-hover || self.activated ? root.bg-hover : transparent;

    callback clicked();

    icon := Icon { 
        color: icon-color;
    }

    area := FocusTouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component StandardButton inherits Rectangle {
    in property <image> icon: Icons.box;
    in property <string> text: "Button";

    callback clicked();

    height: Metrics.px-48;
    background: area.has-hover || area.has-focus ? Theme.bg-hover : transparent;

    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: Metrics.px-8;
        padding-right: Metrics.px-8;

        Icon {
            icon: root.icon;
        }

        EyerisText {
            text: root.text;
        }
    }

    area := FocusTouchArea {
        clicked => {
            root.clicked();
        }
    }
}
