import { Metrics } from "../metrics.slint";
import { Action } from "../globals.slint";
import { Colors } from "../colors.slint";
import { State } from "../globals.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "separator.slint";
import { StandardButton } from "button.slint";
import { FocusTouchArea } from "area.slint";
import { EyerisText } from "text.slint";
import { Popover } from "popover.slint";
import { Icon } from "icon.slint";

export component CollectionButton inherits Rectangle {
    in property <string> text: "Collection";

    min-height: 40px;
    background: area.has-hover || area.has-focus ? Colors.bg-hover : transparent;
    border-radius: Metrics.radius-md;

    HorizontalLayout {
        cross-axis-alignment: center;

        Icon {
            icon: Icons.heart;
        }

        EyerisText {
            text: root.text;
        }
    }

    popover := Popover {
        width: root.width;

        VerticalLayout {
            spacing: Metrics.spacing-4;
            padding: Metrics.spacing-4;

            StandardButton {
                icon: Icons.folder;
                text: "Open";

                clicked => {
                    Action.open-collection();
                }
            }
        }
    }

    area := FocusTouchArea {
        clicked => {
            popover.show();
        }
    }
}
