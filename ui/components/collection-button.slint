import { Metrics } from "../metrics.slint";
import { Action } from "../globals.slint";
import { Colors } from "../colors.slint";
import { State } from "../globals.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "separator.slint";
import { StandardButton } from "button.slint";
import { FocusTouchArea } from "area.slint";
import { PopoverOnce } from "popover.slint";
import { EyerisText } from "text.slint";
import { Icon } from "icon.slint";

export component CollectionButton inherits Rectangle {
    in property <string> text: "Collection";

    height: Metrics.px-60;
    background: area.has-hover || area.has-focus ? Colors.bg-hover : transparent;

    HorizontalLayout {
        cross-axis-alignment: center;
        padding-left: Metrics.px-8;
        padding-right: Metrics.px-8;

        Icon {
            icon: Icons.heart;
        }

        EyerisText {
            text: root.text.is-empty ? "Collection" : root.text;
        }
    }

    popover := PopoverOnce {
        width: root.width;

        VerticalLayout {
            StandardButton {
                icon: Icons.folder;
                text: "Example";
                
                clicked => {
                    Action.open-collection-by-path("fixtures/Example/");
                }
            }
            
            StandardButton {
                icon: Icons.folder;
                text: "Open";

                clicked => {
                    Action.open-collection();
                }
            }
        }
    }

    area := FocusTouchArea {
        clicked => {
            popover.show();
        }
    }
}
