import { Theme } from "../theme.slint";

component BaseSeparator {
    Rectangle {
        background: Theme.separator;
    }
}

export component VerticalSeparator {
    width: 1px;

    BaseSeparator {
        width: 100%;
        height: 100%;
    }
}

export component HorizontalSeparator {
    height: 1px;

    BaseSeparator {
        width: 100%;
        height: 100%;
    }
}
