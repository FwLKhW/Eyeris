import { Colors } from "../colors.slint";

component BaseSeparator {
    Rectangle {
        background: Colors.separator;
    }
}

export component VerticalSeparator {
    width: 1px;

    BaseSeparator {
        width: 100%;
        height: 100%;
    }
}

export component HorizontalSeparator {
    height: 1px;

    BaseSeparator {
        width: 100%;
        height: 100%;
    }
}
