import { Typography } from "../typography.slint";
import { Metrics } from "../metrics.slint";
import { State } from "../globals.slint";

import { EyerisText } from "text.slint";

export component LoadingOverlay inherits Rectangle {
    visible: State.indexing;
    background: rgba(0, 0, 0, 0.8);

    WindowMoveArea {
        VerticalLayout {
            alignment: center;
            cross-axis-alignment: center;
            spacing: Metrics.px-8;

            EyerisText {
                style: Typography.label;
                font-size: 24px;
                text: State.collection.name;
            }
            
            EyerisText {
                style: Typography.body;
                text: State.collection.path;
            }
            
            EyerisText {
                style: Typography.body;
                font-size: 16px;
                text: "Indexing ...";
            }
        }
    }
}
