import { Metrics } from "../metrics.slint";
import { Theme } from "../theme.slint";

export component PopoverOnce inherits PopupWindow {
    in property <LayoutAlignment> v-align: start;

    close-policy: close-on-click;

    y: root.v-align == start ? -self.height : root.height;

    Rectangle {
        background: Theme.bg-surface;
        border-color: Theme.separator;
        border-width: 1px;

        @children
    }
}


export component Popover inherits PopupWindow {
    in property <LayoutAlignment> v-align: start;

    close-policy: close-on-click-outside;

    y: root.v-align == start ? -self.height : root.height;

    Rectangle {
        background: Theme.bg-surface;
        border-color: Theme.separator;
        border-width: 1px;

        @children
    }
}
