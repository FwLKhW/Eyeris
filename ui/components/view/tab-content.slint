import { UIMetrics } from "../../styling/ui-metrics.slint";
import { Icons } from "../../icons/icons.slint";

import { VerticalGroup } from "../ui/vertical-group.slint";
import { FullButton } from "../ui/button.slint";

export component TabContent inherits VerticalLayout {
    alignment: start;
    spacing: UIMetrics.spacing-xl;

    VerticalGroup {
        FullButton {
            left-icon: Icons.box;
            left-text: "All";
        }

        FullButton {
            left-icon: Icons.clock;
            left-text: "Recent";
        }

        FullButton {
            left-icon: Icons.refresh;
            left-text: "Random";
        }

        FullButton {
            left-icon: Icons.trash;
            left-text: "Trash";
        }
    }

    VerticalGroup {
        title: "Tag";
        icon: Icons.tag;
        names: ["Tagged", "Untagged"];
    }

    VerticalGroup {
        title: "View";
        icon: Icons.eye;
        names: ["Ranked", "Artist", "Cinematic"];
    }

    VerticalGroup {
        title: "Tree";
        icon: Icons.folder;
        names: ["Folder", "Subfolder", "Another Folder"];
    }
}
