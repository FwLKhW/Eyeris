import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";

import { FullButton, IconButton } from "../ui/button.slint";
import { IconButtonPopover } from "../ui/popover.slint";

export component TitleBar inherits Rectangle {
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    background: UIPalette.bg-area;

    HorizontalLayout {
        alignment: space-between;
        cross-axis-alignment: center;
        spacing: UIMetrics.spacing-lg;
        padding: UIMetrics.spacing-md;
        padding-left: UIMetrics.spacing-xl;
        padding-right: UIMetrics.spacing-xl;

        IconButtonPopover {
            icon: Icons.menu;
            size: small;
            icon-size: 16px;
            popup-width: 160px;

            FullButton {
                left-icon: Icons.settings;
                left-text: "Settings";
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: UIMetrics.spacing-sm;

            IconButton {
                icon: Icons.minimize;
                size: small;
                icon-size: 16px;

                clicked => {
                    window-minimize();
                }
            }

            IconButton {
                icon: Icons.maximize;
                size: small;
                icon-size: 16px;

                clicked => {
                    window-maximize();
                }
            }

            IconButton {
                icon: Icons.close;
                size: small;
                icon-size: 18px;
                bg-hover: UIPalette.error;

                clicked => {
                    window-close();
                }
            }
        }
    }
}
