import { UIPalette } from "../../styling/ui-palette.slint";
import { HorizontalDivider } from "../common/divider.slint";
import { IconButton } from "../common/button.slint";
import { Skeleton } from "../common/skeleton.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";
import { Icon } from "../common/icon.slint";
import { Icons } from "../../icons/icons.slint";

component Left inherits HorizontalLayout {
    spacing: UIMetrics.spacing-sm;

    IconButton {
        icon: Icons.menu;
    }
}

component Right inherits HorizontalLayout {
    spacing: UIMetrics.spacing-sm;

    IconButton {
        icon: Icons.minimize;
    }

    IconButton {
        icon: Icons.maximize;
    }

    IconButton {
        icon: Icons.close;
        hover: UIPalette.error;
    }
}

export component TitleBar inherits VerticalLayout {
    Rectangle {
        background: UIPalette.bg-area;

        FlexboxLayout {
            alignment: space-between;
            cross-axis-alignment: center;
            spacing: UIMetrics.spacing-lg;
            padding: UIMetrics.spacing-md;
            padding-left: UIMetrics.spacing-xl;
            padding-right: UIMetrics.spacing-xl;

            Left { }

            Right { }
        }
    }

    HorizontalDivider { }
}
