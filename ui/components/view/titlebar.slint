import { UIPalette } from "../../styling/ui-palette.slint";
import { HorizontalDivider } from "../common/divider.slint";
import { IconButton } from "../common/icon-button.slint";
import { Skeleton } from "../common/skeleton.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";

component Left inherits HorizontalLayout {
    spacing: 4px;

    Skeleton {
        width: 40px;
        height: 30px;
    }
}

component Right inherits HorizontalLayout {
    spacing: 2px;

    Skeleton {
        width: 120px;
    }
}

export component TitleBar inherits VerticalLayout {
    Rectangle {
        background: UIPalette.bg-area;

        FlexboxLayout {
            spacing: 8px;
            alignment: space-between;
            cross-axis-alignment: center;
            padding: UIMetrics.spacing-md;
            padding-left: UIMetrics.spacing-lg;
            padding-right: UIMetrics.spacing-lg;

            Left { }

            Right { }
        }
    }

    HorizontalDivider { }
}
