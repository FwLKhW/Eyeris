import { FilterState } from "../../globals.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";

import { MinimalColorPalette } from "../ui/color-palette.slint";
import { IconButtonPopover } from "../ui/popover.slint";
import { IconButton } from "../ui/button.slint";
import { SearchBar } from "../ui/search-bar.slint";
import { Slider } from "../ui/slider.slint";

export component Filter inherits Rectangle {
    clip: true;

    HorizontalLayout {
        spacing: UIMetrics.spacing-sm;
        padding: UIMetrics.spacing-xl;

        HorizontalLayout {
            alignment: start;
            spacing: UIMetrics.spacing-sm;

            IconButtonPopover {
                icon: FilterState.color == transparent ? Icons.circle : Icons.filled-circle;
                icon-color: FilterState.color == transparent ? UIPalette.subtext : FilterState.color;
                icon-hover-color: self.icon-color;
                popup-width: 270px;
                tooltip-text: "Color";

                MinimalColorPalette { }

                HorizontalLayout {
                    alignment: center;

                    Slider {
                        width: 220px;
                        thumb-border-color: UIPalette.bg-surface;
                    }
                }
            }

            IconButton {
                icon: Icons.file-text;
                icon-color: UIPalette.blue;
                icon-hover-color: UIPalette.blue;
                tooltip-text: "Types";
            }

            IconButton {
                icon: Icons.box;
                icon-color: UIPalette.mauve;
                icon-hover-color: UIPalette.mauve;
                tooltip-text: "Shape";
            }

            IconButton {
                icon: Icons.tag;
                icon-color: UIPalette.orange;
                icon-hover-color: UIPalette.orange;
                tooltip-text: "Tags";
            }

            IconButton {
                icon: Icons.star;
                icon-color: UIPalette.yellow;
                icon-hover-color: UIPalette.yellow;
                tooltip-text: "Stars";
            }

            IconButton {
                icon: Icons.crop;
                icon-color: UIPalette.yellow;
                icon-hover-color: UIPalette.yellow;
                tooltip-text: "Dimensions";
            }

            IconButton {
                icon: Icons.clock;
                icon-color: UIPalette.green;
                icon-hover-color: UIPalette.green;
                tooltip-text: "Created";
            }

            IconButton {
                icon: Icons.clock;
                icon-color: UIPalette.orange;
                icon-hover-color: UIPalette.orange;
                tooltip-text: "Modified";
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: UIMetrics.spacing-sm;

            SearchBar {
                min-width: 180px;
                max-length: 16;
            }

            SearchBar {
                min-width: 240px;
                icon: Icons.vector-square;
                placeholder: "Semantic Search";
            }
        }
    }
}
