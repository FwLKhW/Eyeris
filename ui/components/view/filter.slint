import { FilterState } from "../../globals.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";

import { MinimalColorPalette } from "../ui/color-palette.slint";
import { SimpleButtonPopover } from "../ui/popover.slint";
import { SimpleButton } from "../ui/button.slint";
import { SearchBar } from "../ui/search-bar.slint";
import { Slider } from "../ui/slider.slint";
import { TabGroup } from "../ui/tab-group.slint";

export component Filter inherits Rectangle {
    clip: true;

    HorizontalLayout {
        spacing: UIMetrics.spacing-sm;
        padding: UIMetrics.spacing-xl;

        HorizontalLayout {
            alignment: start;
            spacing: UIMetrics.spacing-sm;

            SimpleButtonPopover {
                icon: FilterState.color == transparent ? Icons.circle : Icons.filled-circle;
                color: FilterState.color == transparent ? UIPalette.subtext : FilterState.color;
                hover-color: self.color;
                popup-width: 270px;
                tooltip-text: "Color";

                MinimalColorPalette { }

                HorizontalLayout {
                    alignment: center;

                    Slider {
                        width: 220px;
                        thumb-border-color: UIPalette.bg-surface;
                    }
                }
            }

            SimpleButtonPopover {
                icon: Icons.file-text;
                color: UIPalette.blue;
                hover-color: UIPalette.blue;
                popup-width: 200px;
                tooltip-text: "Types";

                TabGroup {
                    // TODO: icons
                    icons: [Icons.file-text, Icons.file-text, Icons.file-text];
                    labels: ["All", "JPG", "PNG", "WEBP"];
                    show-icon: false;
                }
            }

            SimpleButton {
                icon: Icons.box;
                color: UIPalette.mauve;
                hover-color: UIPalette.mauve;
                tooltip-text: "Shape";
            }

            SimpleButton {
                icon: Icons.tag;
                color: UIPalette.orange;
                hover-color: UIPalette.orange;
                tooltip-text: "Tags";
            }

            SimpleButton {
                icon: Icons.star;
                color: UIPalette.yellow;
                hover-color: UIPalette.yellow;
                tooltip-text: "Stars";
            }

            SimpleButton {
                icon: Icons.crop;
                color: UIPalette.yellow;
                hover-color: UIPalette.yellow;
                tooltip-text: "Dimensions";
            }

            SimpleButton {
                icon: Icons.clock;
                color: UIPalette.green;
                hover-color: UIPalette.green;
                tooltip-text: "Created";
            }

            SimpleButton {
                icon: Icons.clock;
                color: UIPalette.orange;
                hover-color: UIPalette.orange;
                tooltip-text: "Modified";
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: UIMetrics.spacing-sm;

            SearchBar {
                min-width: 180px;
                max-length: 16;
            }

            SearchBar {
                min-width: 240px;
                icon: Icons.vector-square;
                placeholder: "Semantic Search";
            }
        }
    }
}
