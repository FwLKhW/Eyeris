import {
    ImagePreviewState,
    GalleryState,
    LayoutState,
    Actions,
} from "../../globals.slint";
import { IndexedImage } from "../../types.slint";
import { UITypography } from "../../styling/ui-typography.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";

import { FullButtonPopover, IconButtonPopover } from "../ui/popover.slint";
import { HorizontalDivider } from "../ui/divider.slint";
import { ScrollArea } from "../ui/scroll-area.slint";
import { Filter } from "filter.slint";
import { UIText } from "../ui/text.slint";

component ImageItem inherits Rectangle {
    in property <IndexedImage> img;

    background: touch.pressed || touch.has-hover ? UIPalette.bg-hover : transparent;
    horizontal-stretch: pow(img.height / img.width, 2);

    init => {
        thumbnail.source = Actions.load-thumbnail(img.id);
    }

    VerticalLayout {
        cross-axis-alignment: center;
        spacing: UIMetrics.spacing-xl;
        padding: UIMetrics.spacing-xl;

        thumbnail := Image {
            height: 256px;
            min-width: 128px;
            image-fit: cover;
        }

        VerticalLayout {
            alignment: start;
            cross-axis-alignment: center;
            spacing: UIMetrics.spacing-xs;

            UIText {
                text: img.name;
                font-weight: UITypography.medium;
            }

            UIText {
                text: img.width + " x " + img.height;
                style: UITypography.small;
                color: UIPalette.subtext;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            ImagePreviewState.image-path = img.path;
            ImagePreviewState.preview = thumbnail.source;
        }
    }
}

component ImageRow inherits HorizontalLayout {
    height: 360px;
    alignment: space-around;
    cross-axis-alignment: center;
    spacing: UIMetrics.spacing-lg;

    @children
}

export component Gallery inherits Rectangle {
    VerticalLayout {
        if LayoutState.show-filter: VerticalLayout {
            Filter { }

            HorizontalDivider { }
        }

        ScrollArea {
            VerticalLayout {
                spacing: UIMetrics.spacing-2xl;
                padding: UIMetrics.spacing-2xl;

                for start-index in (GalleryState.images.length / GalleryState.per-row-images): ImageRow {
                    for row-item-index in GalleryState.per-row-images: ImageItem {
                        img: GalleryState.images[start-index * GalleryState.per-row-images + row-item-index];
                    }
                }

                ImageRow {
                    for row-item-index in Math.mod(GalleryState.images.length, GalleryState.per-row-images): ImageItem {
                        img: GalleryState.images[GalleryState.images.length - row-item-index - 1];
                    }
                }
            }
        }
    }
}
