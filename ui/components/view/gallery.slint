import { UITypography } from "../../styling/ui-typography.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";
import {
    GalleryState,
    ImagePreviewState,
} from "../../globals.slint";

import { FullButtonPopover, IconButtonPopover } from "../ui/popover.slint";
import { HorizontalDivider } from "../ui/divider.slint";
import { ScrollView } from "../ui/scroll-view.slint";
import { FilterBar } from "filter-bar.slint";
import { UIText } from "../ui/text.slint";

component ImageItem inherits Rectangle {
    in property <string> id;
    in property <image> source;
    in property <string> name;

    background: touch.pressed || touch.has-hover ? UIPalette.bg-hover : transparent;
    horizontal-stretch: pow(source.height / source.width, 2);

    VerticalLayout {
        cross-axis-alignment: center;
        spacing: UIMetrics.spacing-xl;
        padding: UIMetrics.spacing-xl;

        Image {
            height: 256px;
            min-width: 128px;
            source: root.source;
            image-fit: cover;
        }

        VerticalLayout {
            alignment: start;
            cross-axis-alignment: center;
            spacing: UIMetrics.spacing-xs;

            UIText {
                text: root.name;
                font-weight: UITypography.medium;
            }

            UIText {
                text: root.source.width + " x " + root.source.height;
                style: UITypography.small;
                color: UIPalette.subtext;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            GalleryState.selected-image-id = root.id;
            ImagePreviewState.current-source = root.source;
        }
    }
}

component ImageRow inherits HorizontalLayout {
    in property <[image]> images;

    height: 360px;
    alignment: space-around;
    spacing: UIMetrics.spacing-lg;

    for img in images: ImageItem {
        source: img;
        name: "image.png";
    }
}

export component Gallery inherits Rectangle {
    VerticalLayout {
        padding-left: UIMetrics.spacing-xl;
        padding-right: UIMetrics.spacing-xl;

        FilterBar { }

        HorizontalDivider { }

        ScrollView {
            VerticalLayout {
                spacing: UIMetrics.spacing-2xl;

                for index in 8: ImageRow {
                    images: [
                        @image-url("../../../fixtures/images/kurisu.jpg"),
                        @image-url("../../../fixtures/images/thumbnail.jpg"),
                        @image-url("../../../fixtures/images/kurisu.jpg"),
                        @image-url("../../../fixtures/images/thumbnail.jpg"),
                    ];
                }
            }
        }
    }
}
