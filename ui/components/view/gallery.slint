import { UITypography } from "../../styling/ui-typography.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";
import {
    GalleryState,
    ImagePreviewState,
} from "../../globals.slint";
import { HorizontalDivider } from "../ui/divider.slint";
import { FullButtonPopover, IconButtonPopover } from "../ui/popover.slint";
import { ScrollView } from "../ui/scroll-view.slint";
import { IconButton } from "../ui/button.slint";
import { SearchBar } from "../ui/search-bar.slint";
import { UIText } from "../ui/text.slint";
import { ListView } from "std-widgets.slint";
import { MinimalColorPalette } from "../ui/minimal-color-palette.slint";
import { Slider } from "../ui/slider.slint";

component ImageItem inherits Rectangle {
    in property <string> id;
    in property <image> source;
    in property <string> name;

    background: touch.pressed || touch.has-hover ? UIPalette.bg-hover : transparent;
    horizontal-stretch: pow(source.height / source.width, 2);

    VerticalLayout {
        cross-axis-alignment: center;
        spacing: UIMetrics.spacing-xl;
        padding: UIMetrics.spacing-xl;

        Image {
            height: 256px;
            min-width: 128px;
            source: root.source;
            image-fit: cover;
        }

        VerticalLayout {
            alignment: start;
            cross-axis-alignment: center;
            spacing: UIMetrics.spacing-xs;

            UIText {
                text: root.name;
                font-weight: UITypography.medium;
            }

            UIText {
                text: root.source.width + " x " + root.source.height;
                style: UITypography.small;
                color: UIPalette.subtext;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            GalleryState.selected-image-id = root.id;
            ImagePreviewState.current-source = root.source;
        }
    }
}

component ImageRow inherits HorizontalLayout {
    in property <[image]> images;

    height: 360px;
    alignment: space-around;
    spacing: 8px;
    padding: 12px;

    for img in images: ImageItem {
        source: img;
        name: "image.png";
    }
}

component ImageGrid inherits VerticalLayout {
    ListView {
        for index in 8: ImageRow {
            images: [
                @image-url("../../../fixtures/images/kurisu.jpg"),
                @image-url("../../../fixtures/images/thumbnail.jpg"),
                @image-url("../../../fixtures/images/kurisu.jpg"),
                @image-url("../../../fixtures/images/thumbnail.jpg"),
            ];
        }
    }
}

export component Gallery inherits Rectangle {
    VerticalLayout {
        padding-left: UIMetrics.spacing-xl;
        padding-right: UIMetrics.spacing-xl;

        HorizontalLayout {
            spacing: UIMetrics.spacing-sm;
            padding-top: UIMetrics.spacing-xl;
            padding-bottom: UIMetrics.spacing-xl;

            HorizontalLayout {
                alignment: start;
                spacing: UIMetrics.spacing-sm;

                IconButtonPopover {
                    icon: Icons.circle;
                    icon-color: UIPalette.subtext;
                    icon-hover-color: UIPalette.subtext;
                    popup-width: 260px;

                    MinimalColorPalette { }

                    Slider {
                        width: 220px;
                        thumb-border-color: UIPalette.bg-surface;
                    }
                }

                IconButton {
                    icon: Icons.file-text;
                    icon-color: UIPalette.blue;
                    icon-hover-color: UIPalette.blue;
                }

                IconButton {
                    icon: Icons.box;
                    icon-color: UIPalette.mauve;
                    icon-hover-color: UIPalette.mauve;
                }

                IconButton {
                    icon: Icons.tag;
                    icon-color: UIPalette.orange;
                    icon-hover-color: UIPalette.orange;
                }

                IconButton {
                    icon: Icons.star;
                    icon-color: UIPalette.yellow;
                    icon-hover-color: UIPalette.yellow;
                }

                IconButton {
                    icon: Icons.crop;
                    icon-color: UIPalette.yellow;
                    icon-hover-color: UIPalette.yellow;
                }

                IconButton {
                    icon: Icons.clock;
                    icon-color: UIPalette.green;
                    icon-hover-color: UIPalette.green;
                }

                IconButton {
                    icon: Icons.clock;
                    icon-color: UIPalette.orange;
                    icon-hover-color: UIPalette.orange;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: UIMetrics.spacing-sm;

                SearchBar { }

                SearchBar {
                    min-width: 240px;
                    icon: Icons.vector-square;
                    placeholder: "Semantic Search";
                }
            }
        }

        HorizontalDivider { }

        ImageGrid { }
    }
}
