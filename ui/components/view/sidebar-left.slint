import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";
import { TabState } from "../../globals.slint";

import { FullButtonPopover } from "../ui/popover.slint";
import { HorizontalDivider } from "../ui/divider.slint";
import { FullButton } from "../ui/button.slint";
import { TabContent } from "tab-content.slint";
import { ScrollView } from "../ui/scroll-view.slint";
import { TabGroup } from "../ui/tab-group.slint";

export component SidebarLeft inherits Rectangle {
    background: UIPalette.bg-area;

    VerticalLayout {
        padding-left: UIMetrics.spacing-xl;
        padding-right: UIMetrics.spacing-xl;

        TabGroup {
            icons: [Icons.home, Icons.tag, Icons.chart];
            selected-index <=> TabState.current-tab-index;
        }

        HorizontalDivider { }

        ScrollView {
            content-height: tab-content.preferred-height;

            tab-content := TabContent { }
        }

        HorizontalDivider { }

        VerticalLayout {
            padding-top: UIMetrics.spacing-xl;
            padding-bottom: UIMetrics.spacing-xl;

            FullButtonPopover {
                left-icon: Icons.heart;
                left-text: "Library";
                position: top;

                FullButton {
                    left-icon: Icons.folder;
                    left-text: "Open Folder";
                }
            }
        }
    }
}
