import { LayoutState, WindowState, TabState } from "../../globals.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";

import { VerticalDivider, HorizontalDivider } from "../ui/divider.slint";
import { VerticalGroup } from "../ui/vertical-group.slint";
import { Dashboard } from "dashboard.slint";
import { Gallery } from "gallery.slint";
import { Right } from "right.slint";
import { Left } from "left.slint";

export component Main inherits HorizontalLayout {
    if LayoutState.show-left: HorizontalLayout {
        Left {
            width: 240px;
        }

        VerticalDivider { }
    }

    if TabState.current-tab-index == 0: Gallery { }
    if TabState.current-tab-index == 1: Dashboard { }
    if TabState.current-tab-index == 2: Dashboard { }

    if LayoutState.show-right && WindowState.width > 1200px: HorizontalLayout {
        VerticalDivider { }

        Right {
            width: 320px;
        }
    }
}
