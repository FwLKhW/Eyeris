import { UIMetrics } from "../../styling/ui-metrics.slint";
import { Icons } from "../../icons/icons.slint";

import { VerticalGroup } from "../ui/vertical-group.slint";
import { FullButton } from "../ui/button.slint";

export component TabHome inherits VerticalLayout {
    spacing: UIMetrics.spacing-4xl;
    padding: UIMetrics.spacing-xl;

    VerticalGroup {
        FullButton {
            left-icon: Icons.box;
            left-text: "All";
        }

        FullButton {
            left-icon: Icons.clock;
            left-text: "Recent";
        }

        FullButton {
            left-icon: Icons.refresh;
            left-text: "Random";
        }

        FullButton {
            left-icon: Icons.trash;
            left-text: "Trash";
        }
    }

    VerticalGroup {
        title: "Tag";

        FullButton {
            left-icon: Icons.tag;
            left-text: "Tagged";
        }

        FullButton {
            left-icon: Icons.tag;
            left-text: "Untagged";
        }
    }

    VerticalGroup {
        title: "View";

        FullButton {
            left-icon: Icons.eye;
            left-text: "Ranked";
        }

        FullButton {
            left-icon: Icons.tag;
            left-text: "Artist";
        }

        FullButton {
            left-icon: Icons.tag;
            left-text: "Cinematic";
        }
    }

    VerticalGroup {
        title: "Tree";

        FullButton {
            left-icon: Icons.folder;
            left-text: "Folder";
        }

        FullButton {
            left-icon: Icons.folder;
            left-text: "Subfolder";
        }

        FullButton {
            left-icon: Icons.folder;
            left-text: "Another Folder";
        }
    }
}
