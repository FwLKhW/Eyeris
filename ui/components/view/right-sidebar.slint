import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { ColorPalleteState } from "../../globals.slint";
import { HorizontalDivider } from "../ui/divider.slint";
import { ImagePreview } from "../ui/image-preview.slint";
import { ColorPalette } from "../ui/color-pallete.slint";

export component RightSidebar inherits Rectangle {
    background: UIPalette.bg-area;

    VerticalLayout {
        padding-left: UIMetrics.spacing-xl;
        padding-right: UIMetrics.spacing-xl;

        VerticalLayout {
            padding-top: UIMetrics.spacing-2xl;
            padding-bottom: UIMetrics.spacing-2xl;

            ImagePreview {
                source: @image-url("../../../fixtures/images/wallpaper.png");
            }
        }

        HorizontalDivider { }

        VerticalLayout {
            alignment: start;
            cross-axis-alignment: center;
            spacing: UIMetrics.spacing-lg;
            padding-top: UIMetrics.spacing-2xl;
            padding-bottom: UIMetrics.spacing-2xl;

            ColorPalette {
                colors: ColorPalleteState.colors;
            }
        }

        VerticalLayout { }
    }
}
