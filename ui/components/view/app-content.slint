import { Skeleton } from "../common/skeleton.slint";
import { TabGroup } from "tab-group.slint";
import { FolderGroup } from "folder-group.slint";

component Left inherits Rectangle {
    background: UIPalette.bg-area;

    VerticalLayout {
        padding-left: UIMetrics.spacing-lg;
        padding-right: UIMetrics.spacing-lg;
        alignment: start;

        TabGroup { }

        HorizontalDivider { }

        FolderGroup { }
        FolderGroup { }
        FolderGroup { }
    }
}

component Center inherits Rectangle {
    Text {
        text: "Center";
    }
}

component Right inherits Rectangle {
    background: UIPalette.bg-area;

    VerticalLayout {
        padding-left: UIMetrics.spacing-lg;
        padding-right: UIMetrics.spacing-lg;
        alignment: start;

        TabGroup { }

        HorizontalDivider { }

        FolderGroup { }
        FolderGroup { }
        FolderGroup { }
    }
}

export component AppContent inherits HorizontalLayout {
    Left {
        width: 240px;
    }

    VerticalDivider { }

    Center {
        horizontal-stretch: 1;
    }

    VerticalDivider { }

    Right {
        width: 320px;
    }
}
