import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { VerticalDivider, HorizontalDivider } from "../common/divider.slint";
import { Skeleton } from "../common/skeleton.slint";
import { TabGroup } from "tab-group.slint";
import { FolderGroup } from "folder-group.slint";
import { LeftSidebar } from "left-sidebar.slint";

component Center inherits Rectangle {
    Text {
        text: "Center";
    }
}

component Right inherits Rectangle {
    background: UIPalette.bg-area;

    VerticalLayout {
        padding-left: UIMetrics.spacing-xl;
        padding-right: UIMetrics.spacing-xl;
        alignment: start;

        Skeleton {
            height: 256px;
        }

        HorizontalDivider { }

        FolderGroup { }
    }
}

export component AppContent inherits HorizontalLayout {
    LeftSidebar {
        width: 240px;
    }

    VerticalDivider { }

    Center {
        horizontal-stretch: 1;
    }

    VerticalDivider { }

    Right {
        width: 320px;
    }
}
