import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { LayoutState, WindowState } from "../../globals.slint";
import { VerticalDivider, HorizontalDivider } from "../ui/divider.slint";
import { VerticalGroup } from "../ui/vertical-group.slint";
import { LeftSidebar } from "left-sidebar.slint";
import { RightSidebar } from "right-sidebar.slint";
import { Gallery } from "gallery.slint";

export component AppContent inherits HorizontalLayout {
    if LayoutState.show-left-sidebar: HorizontalLayout {
        LeftSidebar {
            width: 240px;
        }

        VerticalDivider { }
    }

    Gallery {
        horizontal-stretch: 1;
    }

    if LayoutState.show-left-sidebar && WindowState.width > 1200px: HorizontalLayout {
        VerticalDivider { }

        RightSidebar {
            width: 320px;
        }
    }
}
