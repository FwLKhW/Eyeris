import { UIMetrics } from "../../styling/ui-metrics.slint";
import { IconButton } from "../common/button.slint";
import { Icons } from "../../icons/icons.slint";

export component TabGroup inherits HorizontalLayout {
    in-out property <int> selected-index: 0;

    padding-top: UIMetrics.spacing-xl;
    padding-bottom: UIMetrics.spacing-xl;

    HorizontalLayout {
        height: 32px;
        spacing: UIMetrics.spacing-sm;

        IconButton {
            icon: Icons.home;
            selected: root.selected-index == 0;
            clicked => { root.selected-index = 0; }
        }

        IconButton {
            icon: Icons.search;
            selected: root.selected-index == 1;
            clicked => { root.selected-index = 1; }
        }

        IconButton {
            icon: Icons.chart;
            selected: root.selected-index == 2;
            clicked => { root.selected-index = 2; }
        }

        IconButton {
            icon: Icons.star;
            selected: root.selected-index == 3;
            clicked => { root.selected-index = 3; }
        }
    }
}
