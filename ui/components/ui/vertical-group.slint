import { UIMetrics } from "../../styling/ui-metrics.slint";
import { UIPalette } from "../../styling/ui-palette.slint";
import { Icons } from "../../icons/icons.slint";
import { FullButton } from "button.slint";
import { UIText } from "text.slint";

component Title inherits HorizontalLayout {
    in property <string> text;

    padding-left: UIMetrics.spacing-lg;
    padding-bottom: UIMetrics.spacing-sm;
    alignment: start;

    UIText {
        text: root.text;
        color: UIPalette.subtext;
    }
}

export component VerticalGroup inherits VerticalLayout {
    in property <string> title;
    in property <image> icon: Icons.folder;
    in property <[string]> names;

    alignment: start;
    spacing: UIMetrics.spacing-sm;
    padding-top: UIMetrics.spacing-lg;
    padding-bottom: UIMetrics.spacing-lg;

    if root.title != "": Title {
        text: root.title;
    }

    VerticalLayout {
        spacing: UIMetrics.spacing-sm;

        for name in root.names: FullButton {
            left-icon: root.icon;
            left-text: name;
        }

        @children
    }
}
