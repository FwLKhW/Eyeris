import { UIPalette } from "../../styling/ui-palette.slint";

export global UIWindowAdapter {
    in property <bool> disable-hover;
}

export component UIWindow inherits Window {
    in property <bool> disable-hover;

    background: UIPalette.bg;

    changed disable-hover => {
        UIWindowAdapter.disable-hover = root.disable-hover;
    }
}
