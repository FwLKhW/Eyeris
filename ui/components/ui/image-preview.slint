import { ImagePreviewState } from "../../globals.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";

export component ImagePreview inherits Rectangle {
    min-width: 256px;
    min-height: 256px;
    max-height: 256px;

    Image {
        source: ImagePreviewState.current-source;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                ImagePreviewState.current-source = ImagePreviewState.current-source;
                ImagePreviewState.is-active = true;
                ImagePreviewState.initial-mouse-x = self.mouse-x;
                ImagePreviewState.initial-mouse-y = self.mouse-y;
                ImagePreviewState.delta-x = self.mouse-x - ImagePreviewState.initial-mouse-x;
                ImagePreviewState.delta-y = self.mouse-y - ImagePreviewState.initial-mouse-y;
            } else if (event.kind == PointerEventKind.up) {
                ImagePreviewState.is-active = false;
            }
        }

        moved => {
            ImagePreviewState.delta-x = self.mouse-x - ImagePreviewState.initial-mouse-x;
            ImagePreviewState.delta-y = self.mouse-y - ImagePreviewState.initial-mouse-y;
        }
    }
}
