import { UIMetrics } from "../../styling/ui-metrics.slint";
import { Icons } from "../../icons/icons.slint";

import { IconButton } from "button.slint";

export component TabGroup inherits HorizontalLayout {
    in property <[image]> icons;
    in-out property <int> selected-index;

    padding: UIMetrics.spacing-xl;

    HorizontalLayout {
        spacing: UIMetrics.spacing-sm;

        for icon[index] in icons: IconButton {
            icon: icon;
            selected: root.selected-index == index;
            clicked => {
                root.selected-index = index;
            }
        }
    }
}
