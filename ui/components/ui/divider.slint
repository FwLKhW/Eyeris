import { UIPalette } from "../../styling/ui-palette.slint";

component BaseDivider {
    Rectangle {
        background: UIPalette.separator;
    }
}

export component VerticalDivider {
    width: 1px;

    BaseDivider {
        width: 100%;
        height: 100%;
    }
}

export component HorizontalDivider {
    height: 1px;

    BaseDivider {
        width: 100%;
        height: 100%;
    }
}
