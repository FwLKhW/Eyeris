import { UIPalette } from "../../styling/ui-palette.slint";
import { UIMetrics } from "../../styling/ui-metrics.slint";

export component Slider {
    in-out property <float> value: 0.5;
    in property <color> thumb-border-color: UIPalette.bg;

    min-width: 120px;
    preferred-width: 240px;
    height: 32px;

    callback changed(float);
    callback released(float);

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        background: UIPalette.bg-hover;
        border-radius: UIMetrics.radius-lg;

        Rectangle {
            x: 0;
            width: root.width * root.value;
            height: parent.height;
            background: UIPalette.text;
            border-radius: UIMetrics.radius-lg;
        }

        TouchArea {
            height: 32px;

            clicked => {
                root.value = clamp(self.mouse-x / root.width, 0, 1);
            }

            moved => {
                root.value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.value);
            }

            pointer_event(event) => {
                if event.kind == PointerEventKind.up {
                    root.released(root.value);
                }
            }
        }
    }

    Rectangle {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) * root.value / 1;
        y: (parent.height - self.height) / 2;
        background: UIPalette.text;
        border-width: 2px;
        border-radius: UIMetrics.radius-lg;
        border-color: root.thumb-border-color;
    }
}
