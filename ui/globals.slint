export struct Collection {
    path: string,
    name: string,
}

export struct IndexedImage {
    path: string,
    name: string,
    format: string,
    size: int,
    width: int,
    height: int,
    created: int,
    modified: int,
    rating: int,
    tags: [string],
    hash: string,
    colors: [color],
}

export global Action {
    callback open-collection();
    
    callback indexing();
    callback indexing-extended();
    callback generate-thumbnails();

    // load thumbnail by hash
    callback get-thumbnail(string) -> image;

    // load image by path
    callback get-image(string) -> image;

    // filter
    callback apply-filters();
}

export global State {
    in-out property <Collection> collection;
    in property <bool> indexing;
    in property <bool> generating-thumbnails;

    in-out property <int> tab-index;

    in property <[IndexedImage]> images;
    in property <IndexedImage> selected-image;
}

export global WindowState {
    in property <length> width;
    in property <length> height;
}

export global ImageOverlayState {
    in-out property <bool> show: false;
    in-out property <image> preview;
    in-out property <image> source;
    in property <length> initial-mouse-x;
    in property <length> initial-mouse-y;
    in property <length> delta-x;
    in property <length> delta-y;
}
