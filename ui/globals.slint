import { UIPalette } from "styling/ui-palette.slint";
import { Library, Align } from "types.slint";

export global Actions {
    callback load-library-list();
}

export global LibraryState {
    in-out property <[Library]> libraries;
}

export global WindowState {
    in-out property <length> width;
    in-out property <length> height;
}

export global LayoutState {
    in-out property <bool> show-titlebar: true;
    in-out property <bool> show-left: true;
    in-out property <bool> show-right: true;
    in-out property <bool> show-filter: true;
    in-out property <bool> prev-show-titlebar: true;
    in-out property <bool> prev-show-left: true;
    in-out property <bool> prev-show-right: true;
    in-out property <bool> prev-show-filter: true;
    in-out property <bool> zen-mode: false;
}

export global TabState {
    in-out property <int> current-tab-index;
}

export global GalleryState {
    in property <string> selected-image-id;
}

export global ImagePreviewState {
    in-out property <image> current-source;
    in-out property <bool> is-active: false;
    in property <length> initial-mouse-x;
    in property <length> initial-mouse-y;
    in property <length> delta-x;
    in property <length> delta-y;
}

export global ColorPaletteState {
    in-out property <[color]> colors: [
        UIPalette.red,
        UIPalette.pink,
        UIPalette.orange,
        UIPalette.yellow,
        UIPalette.mauve,
        UIPalette.blue,
        UIPalette.green,
    ];
}

export global FilterState {
    in-out property <color> color: transparent;
}

export global TooltipState {
    in-out property <string> text: "";
    in-out property <length> x: 0;
    in-out property <length> y: 0;
    in-out property <Align> align: start;
    in-out property <bool> visible: false;
}
