import { UIPalette } from "styling/ui-palette.slint";

export global Actions { }

export global LayoutState {
    in-out property <bool> show-titlebar: true;
    in-out property <bool> show-left-sidebar: true;
    in-out property <bool> show-right-sidebar: true;
}

export global TabState {
    in-out property <int> current-tab-index;
}

export global GalleryState {
    in property <string> selected-image-id;
}

export global ImagePreviewState {
    in-out property <image> current-source;
    in-out property <bool> is-active: false;
    in property <length> initial-mouse-x;
    in property <length> initial-mouse-y;
    in property <length> delta-x;
    in property <length> delta-y;
}

export global ColorPaletteState {
    in-out property <[color]> colors: [
        UIPalette.red,
        UIPalette.pink,
        UIPalette.orange,
        UIPalette.yellow,
        UIPalette.mauve,
        UIPalette.blue,
        UIPalette.green,
    ];
}
