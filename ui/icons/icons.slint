export global Icons {
    out property <image> close: @image-url("close.svg");
    out property <image> home: @image-url("home.svg");
    out property <image> maximize: @image-url("maximize.svg");
    out property <image> menu: @image-url("menu.svg");
    out property <image> minimize: @image-url("minimize.svg");
    out property <image> search: @image-url("search.svg");
}
