import { State } from "../globals.slint";
import { Metrics } from "../metrics.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "../components/separator.slint";
import { CollectionButton } from "../components/collection-button.slint";
import { SidebarButton } from "../widgets/sidebar-button.slint";
import { ScrollArea } from "../components/area.slint";
import { Popover } from "../components/popover.slint";
import { Tabs } from "../components/tab.slint";

export component Left inherits VerticalLayout {
    Tabs {
        icons: [Icons.home, Icons.chart, Icons.tag];
        active-index <=> State.tab-index;
    }

    HorizontalSeparator { }

    ScrollArea {
        VerticalLayout {
            SidebarButton {
                icon: Icons.home;
                text: "All";
                count: 42;
            }

            SidebarButton {
                icon: Icons.clock;
                text: "Recent";
            }

            SidebarButton {
                icon: Icons.refresh;
                text: "Random";
            }

            SidebarButton {
                icon: Icons.tag;
                text: "Tagged";
                count: 12;
            }

            SidebarButton {
                icon: Icons.tag;
                text: "Untagged";
                count: 30;
            }
        }
    }

    HorizontalSeparator { }

    CollectionButton {
        text: State.collection.name;
    }
}
