import { State } from "../globals.slint";

import { Dashboard } from "../views/dashboard.slint";
import { Gallery } from "../views/gallery.slint";

import { Filters } from "../widgets/filters.slint";
import { SearchRow } from "../widgets/search-row.slint";

import { HorizontalSeparator } from "../components/separator.slint";

export component Center inherits VerticalLayout {
    changed width => {
        State.images-per-row = Math.clamp(root.width / 256px, 1, 5);
    }

    Filters { }

    HorizontalSeparator { }

    Gallery { }

    HorizontalSeparator { }

    SearchRow { }
}
