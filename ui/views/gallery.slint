import { Metrics } from "../metrics.slint";
import { State } from "../globals.slint";

import { ImageItem } from "../widgets/image-item.slint";

import { ScrollArea } from "../components/area.slint";

component ImageRow inherits HorizontalLayout {
    height: 400px;
    spacing: Metrics.px-48;

    @children
}

export component Gallery inherits VerticalLayout {
    ScrollArea {
        VerticalLayout {
            padding: Metrics.px-48;
            spacing: Metrics.px-96;

            for start-index in (State.images.length / State.images-per-row): ImageRow {
                for row-item-index in State.images-per-row: ImageItem {
                    img: State.images[start-index * State.images-per-row + row-item-index];
                }
            }

            if Math.mod(State.images.length, State.images-per-row) > 0: ImageRow {
                for row-item-index in Math.mod(State.images.length, State.images-per-row): ImageItem {
                    img: State.images[State.images.length - row-item-index - 1];
                }
            }
        }
    }
}
