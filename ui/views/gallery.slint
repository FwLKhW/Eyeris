import {
    ImageOverlayState,
    IndexedImage,
    Action,
    State,
    ImageProperty,
} from "../globals.slint";
import { Typography } from "../typography.slint";
import { Metrics } from "../metrics.slint";
import { Colors } from "../colors.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "../components/separator.slint";
import { ScrollArea } from "../components/area.slint";
import { EyerisText } from "../components/text.slint";

component PropertyRow {
    in property <ImageProperty> property;
    in property <IndexedImage> img;

    if property == name: EyerisText {
        text: img.path;
        font-weight: Typography.medium;
    }
    if property == dimensions: EyerisText {
        text: img.width + " x " + img.height;
        style: Typography.small;
        color: Colors.fg-faded;
    }
    if property == size: EyerisText {
        text: img.size < 102400 ? (img.size / 1024).to-fixed(2) + " KB" : (img.size / 1024 / 1024).to-fixed(2) + " MB";
        style: Typography.small;
        color: Colors.fg-faded;
    }
}

component ImageItem inherits Rectangle {
    in property <IndexedImage> img;

    background: touch.pressed || touch.has-hover ? Colors.bg-hover : transparent;
    horizontal-stretch: pow(img.height / img.width, 2);
    border-radius: Metrics.radius-md;

    init => {
        thumbnail.source = Action.get-thumbnail(img.hash);
        thumbnail.opacity = 1;
    }

    VerticalLayout {
        spacing: Metrics.spacing-32;
        padding: Metrics.spacing-16;

        HorizontalLayout {
            height: 256px;
            min-width: 128px;

            thumbnail := Image {
                opacity: 0;
                image-fit: ImageFit.contain;

                animate opacity {
                    duration: Metrics.opacity-duration;
                    easing: ease-out;
                }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            cross-axis-alignment: center;
            spacing: Metrics.spacing-24;

            PropertyRow {
                img: root.img;
                property: name;
            }

            PropertyRow {
                img: root.img;
                property: dimensions;
            }

            PropertyRow {
                img: root.img;
                property: size;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;

        clicked => {
            State.selected-image = img;
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                ImageOverlayState.preview = thumbnail.source;
                ImageOverlayState.image-path = root.img.path;
                if ImageOverlayState.loaded-image-path != ImageOverlayState.image-path {
                    ImageOverlayState.source = Action.get-image(ImageOverlayState.image-path);
                }
                ImageOverlayState.loaded-image-path = ImageOverlayState.image-path;
                ImageOverlayState.initial-mouse-x = self.mouse-x;
                ImageOverlayState.initial-mouse-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up) {
                ImageOverlayState.show = false;
            }
        }

        moved => {
            ImageOverlayState.show = true;

            ImageOverlayState.delta-x = (self.mouse-x - ImageOverlayState.initial-mouse-x) * ((ImageOverlayState.source.width / 1980 + ImageOverlayState.source.height / 1080) / 2);
            ImageOverlayState.delta-y = (self.mouse-y - ImageOverlayState.initial-mouse-y) * ((ImageOverlayState.source.width / 1980 + ImageOverlayState.source.height / 1080) / 2);
        }
    }
}

component ImageRow inherits HorizontalLayout {
    height: 400px;
    spacing: Metrics.spacing-16;

    @children
}

export component Gallery inherits VerticalLayout {
    ScrollArea {
        VerticalLayout {
            spacing: Metrics.spacing-16;
            padding: Metrics.spacing-16;

            for start-index in (State.images.length / 4): ImageRow {
                for row-item-index in 4: ImageItem {
                    img: State.images[start-index * 4 + row-item-index];
                }
            }

            if Math.mod(State.images.length, 4) > 0: ImageRow {
                for row-item-index in Math.mod(State.images.length, 4): ImageItem {
                    img: State.images[State.images.length - row-item-index - 1];
                }
            }
        }
    }
}
