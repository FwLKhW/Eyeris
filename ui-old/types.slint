export enum Align {
    start,
    center,
    end,
}

export struct Collection {
    path: string,
    name: string,
}

export struct IndexedImage {
    id: string,
    path: string,
    name: string,
    format: string,
    size: int,
    width: int,
    height: int,
    indexed: int,
    created: int,
    modified: int,
    rating: int,
    tags: [string],
    creator: string,
    description: string,
    palette: [color],
}
