export global UIMetrics {
    // icon
    out property <length> icon-md: 20px;
    out property <length> icon-container-md: 24px;

    // border-radius
    out property <length> radius-sm: 5px;
    out property <length> radius-md: 7px;
    out property <length> radius-lg: 9px;

    // spacing
    out property <length> spacing-xs: 2px;
    out property <length> spacing-sm: 4px;
    out property <length> spacing-md: 6px;
    out property <length> spacing-lg: 8px;
    out property <length> spacing-xl: 12px;
    out property <length> spacing-2xl: 16px;
    out property <length> spacing-3xl: 20px;
    out property <length> spacing-4xl: 24px;
}
