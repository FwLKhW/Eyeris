import "../assets/fonts/Monda.ttf";

import {
    EyerisTypography,
    EyerisPalette,
} from "lib.slint";

export component App inherits Window {
    title: "Eyeris";
    icon: @image-url("../assets/icon.svg");

    default-font-family: "Monda";
    default-font-weight: EyerisTypography.regular;

    background: EyerisPalette.bg;

    min-width: 960px;
    min-height: 640px;
    preferred-width: 1560px;
    preferred-height: 840px;
    maximized: true;

    no-frame: true;
    resize-border-width: 6px;
}
