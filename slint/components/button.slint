import { Metrics } from "../metrics.slint";
import { Colors } from "../colors.slint";
import { Icons } from "../icons.slint";

import { FocusTouchArea } from "area.slint";
import { EyerisText } from "text.slint";

export component Icon inherits HorizontalLayout {
    in property <image> icon: Icons.information;
    in property <length> size: 32px;
    in property <float> scale: 1;

    alignment: center;
    cross-axis-alignment: center;
    width: self.size;
    height: self.size;

    Image {
        width: root.size * 0.6 * root.scale;
        source: root.icon;
        colorize: Colors.fg;
    }
}

export component IconButton inherits Rectangle {
    out property <bool> has-hover <=> area.has-hover;
    out property <bool> has-focus <=> area.has-focus;
    in property <length> size <=> icon.size;
    in property <float> ratio: 1;
    in property <image> icon <=> icon.icon;
    in property <float> icon-scale <=> icon.scale;
    in property <color> bg-hover: Colors.bg-hover;
    in property <string> tooltip <=> area.tooltip;
    in property <length> tooltip-offset <=> area.tooltip-offset;

    height: self.size;
    width: self.height * self.ratio;
    background: area.has-focus || area.has-hover ? root.bg-hover : transparent;

    callback clicked();

    icon := Icon { }

    area := FocusTouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component SidebarButton inherits Rectangle {
    in property <image> icon: Icons.box;
    in property <string> text: "Button";
    in property <int> count: 0;

    min-height: 40px;
    background: area.has-hover || area.has-focus ? Colors.bg-hover : transparent;

    HorizontalLayout {
        cross-axis-alignment: center;

        Icon {
            icon: root.icon;
        }

        EyerisText { text: root.text; }

        if root.count > 0: HorizontalLayout {
            padding-left: Metrics.spacing-8;
            padding-right: Metrics.spacing-8;

            EyerisText { text: root.count; }
        }
    }

    area := FocusTouchArea { }
}