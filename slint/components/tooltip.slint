import { Typography } from "../typography.slint";
import { Colors } from "../colors.slint";

import { EyerisText } from "text.slint";

export component Tooltip inherits Rectangle {
    in property <string> text;

    width: txt.width + 16px;
    height: txt.height + 12px;
    background: Colors.bg-area;
    border-width: 1px;
    border-color: Colors.fg.with-alpha(Colors.separator-opacity);

    txt := EyerisText {
        style: Typography.small;
        text: root.text;
    }
}

export component TooltipWrapper inherits Rectangle {
    in property <string> tooltip;

    if touch.has-hover: Tooltip {
        text: root.tooltip;
    }

    touch := TouchArea { }
}
