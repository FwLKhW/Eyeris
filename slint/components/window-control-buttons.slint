import { Animations } from "../animations.slint";
import { Colors } from "../colors.slint";
import { Icons } from "../icons.slint";

import { IconButton } from "button.slint";

export component WindowControlButtons inherits HorizontalLayout {
    callback minimize();
    callback maximize();
    callback close();
    
    animate opacity {
        duration: Animations.opacity-duration;
    }

    opacity: mini.has-hover || maxi.has-hover || cls.has-hover ? 1 : 0;
    
    mini := IconButton {
        icon: Icons.minimize;
        ratio: 1.5;
        icon-scale: 0.8;
        tooltip: "Minimize";
        tooltip-offset: self.height + 8px;

        clicked => {
            minimize();
        }
    }

    maxi := IconButton {
        icon: Icons.maximize;
        ratio: 1.5;
        icon-scale: 0.8;
        tooltip: "Maximize";
        tooltip-offset: self.height + 8px;

        clicked => {
            maximize();
        }
    }

    cls := IconButton {
        icon: Icons.close;
        ratio: 1.5;
        icon-scale: 0.9;
        bg-hover: Colors.danger;
        tooltip: "Close";
        tooltip-offset: self.height + 8px;

        clicked => {
            close();
        }
    }
}
