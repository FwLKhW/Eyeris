import { Colors } from "../colors.slint";
import { Icons } from "../icons.slint";

import { IconButton } from "button.slint";

export component WindowControlButtons inherits HorizontalLayout {
    callback minimize();
    callback maximize();
    callback close();

    IconButton {
        icon: Icons.minimize;
        ratio: 1.5;
        icon-scale: 0.75;
        tooltip: "Minimize";
        tooltip-offset: self.height + 8px;

        clicked => {
            minimize();
        }
    }

    IconButton {
        icon: Icons.maximize;
        ratio: 1.5;
        icon-scale: 0.7;
        tooltip: "Maximize";
        tooltip-offset: self.height + 8px;

        clicked => {
            maximize();
        }
    }

    IconButton {
        icon: Icons.close;
        ratio: 1.5;
        icon-scale: 0.75;
        bg-hover: Colors.danger;
        tooltip: "Close";
        tooltip-offset: self.height + 8px;

        clicked => {
            close();
        }
    }
}
