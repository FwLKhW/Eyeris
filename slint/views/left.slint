import { Metrics } from "../metrics.slint";
import { Icons } from "../icons.slint";

import { SidebarButton, CollectionButton } from "../components/button.slint";
import { HorizontalSeparator } from "../components/separator.slint";
import { ScrollArea } from "../components/area.slint";
import { Tabs } from "../components/tab.slint";

export component Left inherits VerticalLayout {
    Tabs {
        icons: [Icons.home, Icons.chart, Icons.tag];
    }

    HorizontalSeparator { }

    ScrollArea {
        vertical-stretch: 1;

        VerticalLayout {
            spacing: Metrics.spacing-8;
            padding: Metrics.spacing-8;

            SidebarButton {
                icon: Icons.home;
                text: "All";
                count: 42;
            }

            SidebarButton {
                icon: Icons.clock;
                text: "Recent";
            }

            SidebarButton {
                icon: Icons.refresh;
                text: "Random";
            }

            SidebarButton {
                icon: Icons.tag;
                text: "Tagged";
                count: 12;
            }

            SidebarButton {
                icon: Icons.tag;
                text: "Untagged";
                count: 30;
            }
        }
    }

    HorizontalSeparator { }

    VerticalLayout {
        padding: Metrics.spacing-8;

        CollectionButton { }
    }
}
