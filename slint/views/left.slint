import { Metrics } from "../metrics.slint";
import { Icons } from "../icons.slint";

import { HorizontalSeparator } from "../components/separator.slint";
import { SidebarButton } from "../components/button.slint";
import { Tabs } from "../components/tab.slint";

export component Left inherits VerticalLayout {
    Tabs {
        icons: [Icons.home, Icons.chart, Icons.tag];
    }
    
    HorizontalSeparator { }
    
    VerticalLayout {
        vertical-stretch: 1;
        spacing: Metrics.spacing-8;
        padding: Metrics.spacing-8;

        SidebarButton {
            icon: Icons.home;
            text: "All";
        }
        SidebarButton {
            icon: Icons.clock;
            text: "Recent";
        }
        SidebarButton {
            icon: Icons.refresh;
            text: "Random";
        }
        SidebarButton {
            icon: Icons.trash;
            text: "Trash";
        }
    }

    HorizontalSeparator { }

    Rectangle { }
}
